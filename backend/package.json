{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "test:lab": "tsx --test --test-reporter=spec lab-tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@upto/contracts": "*",
    "cors": "2.8.6",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
