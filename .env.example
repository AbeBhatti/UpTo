# Supabase session pooler URL, for example postgresql://postgres. :<password>@<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xdeiummnbdevmtwwohaq:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Signs the session cookie. Required in production: without it every sign-in and
# session check fails. In development an insecure built-in default is used if unset.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Backend HTTP port
PORT=4000
# Allowed browser origin for the backend
WEB_ORIGIN=http://localhost:3000
# Backend URL used by the web app
NEXT_PUBLIC_API_URL=http://localhost:4000
# Use fixture data in the web app by default
NEXT_PUBLIC_USE_FIXTURES=true
